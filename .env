# Where the FastAPI backend lives. Every route starts with /api.
VITE_API_URL=http://localhost:8000/api

# true  = use the JSON files in src/mocks (no backend needed)
# false = call the real backend at VITE_API_URL
VITE_USE_MOCKS=true

# Show the "Demonstration data" badge on every screen (set false once real data is in)
VITE_SHOW_DEMO_BADGE=true
